# PathFinder AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3005

# Security & JWT Auth
SECRET_KEY=pathfinder_super_secret_production_key_change_in_prod_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL URL for Supabase/Neon, or fallback sqlite)
